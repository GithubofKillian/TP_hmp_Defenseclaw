        "uid": "defenseclaw-loki"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "defenseclaw-loki"
          },
          "instant": true,
          "expr": "sort_desc(sum by (rule_id, scanner, severity) (count_over_time({service_name=\"defenseclaw\"} | json | __error__=\"\" | event_name=\"finding.observed\" | label_format rule_id=\"{{.body_defenseclaw_finding_rule_id}}\", scanner=\"{{.body_defenseclaw_scan_scanner}}\", severity=\"{{.body_defenseclaw_security_severity}}\", target=\"{{.body_defenseclaw_finding_location}}\" [$__range])))",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "rule_id": "Règle",
              "scanner": "Moteur",
              "severity": "Sévérité",
              "Value": "Occurrences"
            },
            "indexByName": {
              "rule_id": 0,
              "scanner": 1,
              "severity": 2,
              "Value": 3
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          },
          "noValue": "Aucune donnée"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Sévérité"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "CRITICAL": {
                        "color": "dark-red",
                        "index": 0
                      },
                      "HIGH": {
                        "color": "orange",
                        "index": 1
                      },
                      "MEDIUM": {
                        "color": "yellow",
                        "index": 2
                      },
                      "LOW": {
                        "color": "blue",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Occurrences",
            "desc": true
          }
        ]
