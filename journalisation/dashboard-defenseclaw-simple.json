    {
      "id": 10,
      "type": "table",
      "title": "Guardrail : outil / action / sévérité (nécessite le guardrail activé)",
      "datasource": {
        "type": "prometheus",
        "uid": "defenseclaw-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "description": "Alimenté par defenseclaw_inspect_evaluations_total, uniquement quand le guardrail est activé et inspecte des appels d'outils.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "defenseclaw-prometheus"
          },
          "instant": true,
          "format": "table",
          "expr": "sort_desc(round(sum by (tool, action, severity) (increase(defenseclaw_inspect_evaluations_total[$__range]))) > 0)"
