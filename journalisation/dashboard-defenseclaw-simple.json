  "description": "Règles remontées, moteur de détection, sévérité et cible associée (source : événements finding.observed dans Loki). À importer via Dashboards > New > Import.",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Findings (période)",
      "datasource": {
        "type": "loki",
        "uid": "defenseclaw-loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "defenseclaw-loki"
          },
          "instant": true,
          "expr": "sum(count_over_time({service_name=\"defenseclaw\"} | json | __error__=\"\" | event_name=\"finding.observed\" | label_format rule_id=\"{{.body_defenseclaw_finding_rule_id}}\", scanner=\"{{.body_defenseclaw_scan_scanner}}\", severity=\"{{.body_defenseclaw_security_severity}}\", target=\"{{.body_defenseclaw_finding_location}}\" [$__range])) or vector(0)",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0,
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
